rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Validar formato de um favorito antes de salvar
    function isValidFavorite() {
      let data = request.resource.data;
      return data.name is string 
        && data.latitude is number 
        && data.longitude is number;
    }

    // Validar formato do cadastro de CEP para SMS
    function isValidSms() {
      let data = request.resource.data;
      return data.zipcode is string 
        && data.zipcode.size() >= 5 
        && data.zipcode.size() <= 9;
    }

    match /favorites/{docId} {
      allow read: if true;
      allow write: if isValidFavorite();
      allow delete: if true;
    }
    
    match /sms_registrations/{docId} {
      allow read: if true;
      allow write: if isValidSms();
      allow delete: if true;
    }

    match /settings/{docId} {
      allow read, write: if true;
    }

    match /weather_notes/{docId} {
      allow read, write: if true;
      allow delete: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
